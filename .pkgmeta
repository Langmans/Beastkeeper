package-as: Beastkeeper

# Ace3 is fetched at package time and never committed, pinned to a commit on master of its GitHub
# mirror: the latest release (Release-r1403, 2026-08-12) lacks AceDB's WoW: Forever fixes of
# September (character keys, profile names). Back to a release tag once one has them
# (docs/06-libraries.md). tests/libs.lua reads this block and fetches the same commits into Libs/
# for the tests, so tests and release always run the same Ace3.
externals:
  Libs/LibStub:
    url: https://github.com/WoWUIDev/Ace3.git
    commit: 40f4cc1356ae7fcc0cf71fc0a19dc7d50d6ae6c2
    path: LibStub
  Libs/CallbackHandler-1.0:
    url: https://github.com/WoWUIDev/Ace3.git
    commit: 40f4cc1356ae7fcc0cf71fc0a19dc7d50d6ae6c2
    path: CallbackHandler-1.0
  Libs/AceAddon-3.0:
    url: https://github.com/WoWUIDev/Ace3.git
    commit: 40f4cc1356ae7fcc0cf71fc0a19dc7d50d6ae6c2
    path: AceAddon-3.0
  Libs/AceEvent-3.0:
    url: https://github.com/WoWUIDev/Ace3.git
    commit: 40f4cc1356ae7fcc0cf71fc0a19dc7d50d6ae6c2
    path: AceEvent-3.0
  Libs/AceConsole-3.0:
    url: https://github.com/WoWUIDev/Ace3.git
    commit: 40f4cc1356ae7fcc0cf71fc0a19dc7d50d6ae6c2
    path: AceConsole-3.0
  Libs/AceDB-3.0:
    url: https://github.com/WoWUIDev/Ace3.git
    commit: 40f4cc1356ae7fcc0cf71fc0a19dc7d50d6ae6c2
    path: AceDB-3.0
  Libs/AceDBOptions-3.0:
    url: https://github.com/WoWUIDev/Ace3.git
    commit: 40f4cc1356ae7fcc0cf71fc0a19dc7d50d6ae6c2
    path: AceDBOptions-3.0
  Libs/AceLocale-3.0:
    url: https://github.com/WoWUIDev/Ace3.git
    commit: 40f4cc1356ae7fcc0cf71fc0a19dc7d50d6ae6c2
    path: AceLocale-3.0
  Libs/AceGUI-3.0:
    url: https://github.com/WoWUIDev/Ace3.git
    commit: 40f4cc1356ae7fcc0cf71fc0a19dc7d50d6ae6c2
    path: AceGUI-3.0
  Libs/AceConfig-3.0:
    url: https://github.com/WoWUIDev/Ace3.git
    commit: 40f4cc1356ae7fcc0cf71fc0a19dc7d50d6ae6c2
    path: AceConfig-3.0
  # LibSink lives only in CurseForge's svn; pinned to a release tag.
  Libs/LibSink-2.0:
    url: https://repos.curseforge.com/wow/libsink-2-0/trunk/LibSink-2.0
    tag: v12.1.1
    type: svn
  # The data broker standard (Titan Panel, ChocolateBar, ElvUI datatexts read it); its last commit,
  # it has no release tags.
  Libs/LibDataBroker-1.1:
    url: https://github.com/tekkub/libdatabroker-1-1.git
    commit: 1a63ede0248c11aa1ee415187c1f9c9489ce3e02
  # The minimap button for the data object; it lives only in CurseForge's svn, pinned to a tag.
  Libs/LibDBIcon-1.0:
    url: https://repos.curseforge.com/wow/libdbicon-1-0/trunk/LibDBIcon-1.0
    tag: v12.1.1
    type: svn
  # The About page, from the .toc's fields (github.com/Myrroddin/libaboutpanel-2.0); pinned to
  # the commit of its tag 1.0.92.
  Libs/LibAboutPanel-2.0:
    url: https://github.com/Myrroddin/libaboutpanel-2.0.git
    commit: 38ec916c1b035a327d2856fa81d4a09fb99e89bc
    path: LibAboutPanel-2.0
  # The route library, Beastkeeper's own (github.com/Langmans/LibGoThere-1.0); pinned to a commit.
  Libs/LibGoThere-1.0:
    url: https://github.com/Langmans/LibGoThere-1.0.git
    commit: 510d0318645d1a2ce01d159c761d3b5da9567d53
  # The world map button's place: one row with Blizzard's and other addons' map buttons
  # (MapNotes, RareScanner, Questie use it too); github.com/TheKrowi/Krowi_WorldMapButtons,
  # BSD-3-Clause, pinned to the commit of its tag 1.4.12.
  Libs/Krowi_WorldMapButtons:
    url: https://github.com/TheKrowi/Krowi_WorldMapButtons.git
    commit: 8c6eee65fecf8d3a70423993a16d538d0a3dcb0a
  # The pet ability ranks and the beasts that teach them, Beastkeeper's own
  # (github.com/Langmans/LibTameable-1.0, GPL-3.0); pinned to a commit.
  Libs/LibTameable-1.0:
    url: https://github.com/Langmans/LibTameable-1.0.git
    commit: 20532c2ad1a429559e3dc37c9d79ac337504f7ab

# Release notes come from this file instead of the commit log, so commit
# bodies and trailers stay out of the CurseForge page.
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

# Files starting with a dot are left out by the packager already.
ignore:
  - annotations
  - coverage
  - tests
  - beastkeeper-dev-1.rockspec
  - stylua.toml
  - tasks
  - Locales/README.md
  - docs/images
